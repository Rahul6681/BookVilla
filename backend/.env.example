# BookVilla Server Configuration (Unit IV & Unit V)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Unit V - Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/bookvilla

# Email Integration (Unit IV - Nodemailer)
# If left blank, Nodemailer will auto-generate an Ethereal test mailbox or log full invoice preview
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="BookVilla Books <orders@bookvilla.in>"

# File Upload Directory (Unit IV - Multer)
UPLOAD_DIR=uploads/books
