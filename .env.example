# BookVilla Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Local Compass or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/bookvilla
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bookvilla?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/bookvilla

# JWT Authentication Secrets
JWT_SECRET=bookvilla_production_jwt_secret_key_2026_india
JWT_REFRESH_SECRET=bookvilla_production_jwt_refresh_secret_key_2026_india
JWT_ACCESS_EXPIRE=1h
JWT_REFRESH_EXPIRE=30d

# SMTP Nodemailer (Optional - defaults to auto-generated Ethereal test account)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=curator@bookvilla.in
# EMAIL_PASS=your_app_password
# EMAIL_FROM="BookVilla Support" <contact@bookvilla.in>
